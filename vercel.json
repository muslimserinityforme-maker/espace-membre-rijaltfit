{
  "crons": [
    { "path": "/api/send-daily-telegram", "schedule": "0 7 * * *" },
    { "path": "/api/keep-alive", "schedule": "0 6 * * *" }
  ],
  "functions": {
    "api/analyze-meal.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
